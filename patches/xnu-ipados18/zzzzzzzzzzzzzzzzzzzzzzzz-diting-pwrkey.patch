+/* Long press of the power key: ask the firmware to power the SoC off. A return
+ * is an error, not a shutdown: keep running and only retry after a release. */
+static void pwrkey_poweroff(void)
+{
+    uint64_t version=diting_psci(0x84000000u,0),feature=diting_psci(0x8400000au,0x84000008u);
+    printf("Diting pwrkey: power held %u ms; PSCI v%llu SYSTEM_OFF feature=%lld\n",
+        pwrkey_long_ms,(unsigned long long)version,(long long)feature);
+    ml_set_interrupts_enabled(false);
+    uint64_t result=diting_psci(0x84000008u,0);
+    pwrkey_off_failed=true;
+    ml_set_interrupts_enabled(true);
+    printf("Diting pwrkey: PSCI SYSTEM_OFF returned %llu; still running\n",(unsigned long long)result);
+}
