+#if defined(DITING) && (DEVELOPMENT || DEBUG)
+/* Lock-free exception record into the ramoops zone tail: no allocation, no
+ * locks, no printf. The UFS mirror rewrites zone0 while its size grows, so
+ * records ride out to UFS with the console. Safe in any exception context.
+ * After the record lands in RAM a best-effort try-lock write pushes the
+ * console head plus this record window straight to the UFS reserve, so the
+ * evidence survives even when the kernel dies before the mirror thread runs. */
+extern int native_ufs_debug_write_try(uint64_t, uint32_t, const void *) __attribute__((weak_import));
+extern uint32_t diting_ramoops_zone_size(unsigned);
+static unsigned diting_sync_exc_seq, diting_serr_exc_seq, diting_stk_exc_seq;
+static void
+diting_exc_ufs_push(vm_offset_t base, uint32_t headcap)
+{
+	uint32_t size = diting_ramoops_zone_size(0);
+	uint32_t blocks = (size + 16 + 4095) / 4096;
+	if (blocks > headcap)
+		blocks = headcap;
+	if (blocks)
+		native_ufs_debug_write_try(0, blocks,
+		    (const void *)(uintptr_t)base);
+	native_ufs_debug_write_try(0x1f0, 2,
+	    (const void *)(uintptr_t)(base + 0x1f0000));
+}
+static void
+diting_exc_record(unsigned *seqp, uintptr_t recoff, uint64_t tag,
+    uint64_t esr, vm_offset_t far, arm_saved_state_t *state)
+{
+	vm_offset_t base = diting_ramoops_mapped_base ?
+	    diting_ramoops_mapped_base() : 0;
+	unsigned n;
+	if (!base)
+		return;
+	const struct arm_saved_state64 *s64 = state ? &state->ss_64 : NULL;
+	n = __atomic_fetch_add(seqp, 1, __ATOMIC_RELAXED);
+	if (n >= 12)
+		return;
+	volatile uint64_t *rec =
+	    (volatile uint64_t *)(uintptr_t)(base + recoff) + n * 16;
+	rec[0] = 0x454c3158454c0000ULL | n;
+	rec[1] = tag;
+	rec[2] = esr;
+	rec[3] = (uint64_t)far;
+	rec[4] = s64 ? s64->pc : 0;
+	rec[5] = s64 ? s64->sp : 0;
+	rec[6] = s64 ? s64->lr : 0;
+	rec[7] = s64 ? s64->fp : 0;
+	rec[8] = s64 ? s64->x[0] : 0;
+	rec[9] = s64 ? s64->x[1] : 0;
+	rec[10] = s64 ? s64->x[2] : 0;
+	rec[11] = s64 ? s64->x[3] : 0;
+	rec[12] = ~rec[4];
+	rec[13] = 0xdead000000000000ULL | tag;
+	if (native_ufs_debug_write_try)
+		diting_exc_ufs_push(base, 64);
+}
+/* panic_spin_forever tail call: console output has already reached the
+ * ramoops backend, so one last mirror carries the panic text and every
+ * exception record out to the UFS reserve before the CPU parks. */
+void
+diting_panic_ufs_flush(void)
+{
+	if (!native_ufs_debug_write_try)
+		return;
+	vm_offset_t base = diting_ramoops_mapped_base ?
+	    diting_ramoops_mapped_base() : 0;
+	if (!base)
+		return;
+	for (unsigned zone = 0; zone < 2; zone++) {
+		uint32_t size = diting_ramoops_zone_size(zone);
+		uint32_t blocks = (size + 16 + 4095) / 4096;
+		if (blocks > 512)
+			blocks = 512;
+		if (blocks)
+			native_ufs_debug_write_try((uint64_t)zone * 512, blocks,
+			    (const void *)(uintptr_t)(base + zone * 0x200000));
+	}
+	native_ufs_debug_write_try(0x1f0, 2,
+	    (const void *)(uintptr_t)(base + 0x1f0000));
+}
