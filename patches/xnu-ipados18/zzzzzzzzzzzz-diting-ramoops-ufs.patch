+/* Exported for the UFS mirror thread (bsd/dev/diting_ramoops_ufs.c): the mapped
+ * base lets it copy both zones without knowing the io_map internals, and the
+ * zone sizes are its change detection so it only rewrites dirty data. */
+vm_offset_t diting_ramoops_mapped_base(void);
+vm_offset_t
+diting_ramoops_mapped_base(void)
+{
+	return diting_ramoops_base;
+}
+
+uint32_t diting_ramoops_zone_size(unsigned);
+uint32_t
+diting_ramoops_zone_size(unsigned zone)
+{
+	if (zone != 0) return diting_diagnostic_size;
+	if (!diting_ramoops_base) return 0;
+	struct diting_ramoops_header *header =
+	    (struct diting_ramoops_header *)(uintptr_t)diting_ramoops_base;
+	return header->size;
+}
--- /dev/null
+++ b/bsd/dev/diting_ramoops_ufs.c
@@ -0,0 +1,171 @@
+/* Mirror the ramoops console/diagnostic zones into the userdata-tail reserve
+ * so an offline recovery can dd the last diting_data_reserve MiB without a
+ * /dev/mem path. Requires diting_ramoops_ufs=1 plus the NativeUfs debug export
+ * (diting_ufs_readwrite=1). Writes are bounded by the open reserve window and
+ * FUA'd by the shared transport path; this thread never allocates and never
+ * runs on the console write path. Each pass writes only the live bytes of a
+ * zone (its declared size plus the 16-byte header) instead of the whole 2 MiB
+ * window, and re-flushes every ~2 s so ring wrap or a missed edge cannot leave
+ * the mirror permanently stale. The exception-record window at zone0+0x1f0000
+ * rides along on every pass that touched zone0 or hit the periodic tick.
+ *
+ * diting_ufslog=1 turns the first pass into a read-back instead: before any
+ * mirror write can overwrite the reserve, the previous boot's zone0 console
+ * tail, exception-record windows and zone1 diagnostic tail are re-read from
+ * the userdata tail and printed on the boot console, so a device with no
+ * recovery shell still yields the last log through the framebuffer. */
+#include <pexpert/arm64/board_config.h>
+#if defined(DITING)
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <string.h>
+
+extern vm_offset_t diting_ramoops_mapped_base(void);
+extern uint32_t diting_ramoops_zone_size(unsigned);
+extern int native_ufs_debug_write(uint64_t, uint32_t, const void *) __attribute__((weak_import));
+extern int native_ufs_debug_read(uint64_t, uint32_t, void *) __attribute__((weak_import));
+extern void IOSleep(unsigned int);
+
+#define DITING_RAMOOPS_ZONE_BYTES 0x00200000U
+#define DITING_RAMOOPS_ZONE_BLOCKS (DITING_RAMOOPS_ZONE_BYTES / 4096U)
+#define DITING_RAMOOPS_RECORD_LBA 0x1f0ULL /* zone0 + 0x1f0000 */
+
+static uint8_t diting_ufslog_buf[DITING_RAMOOPS_ZONE_BYTES];
+
+/* Print the last lines of a captured zone on the console. The console zone is
+ * mostly text; binary runs between log entries act as line breaks. */
+static void
+diting_ufslog_emit(const char *tag, const uint8_t *buf, uint32_t size)
+{
+	uint32_t n = size, start, ll = 0;
+	char line[200];
+	if (n > 16 && buf[0] == 'D' && buf[1] == 'B' && buf[2] == 'G' && buf[3] == 'C') {
+		uint32_t declared = (uint32_t)buf[8] | ((uint32_t)buf[9] << 8) |
+		    ((uint32_t)buf[10] << 16) | ((uint32_t)buf[11] << 24);
+		if (declared && declared + 16 <= n)
+			n = declared + 16;
+	}
+	while (n && (buf[n - 1] == 0 || buf[n - 1] == '\n' || buf[n - 1] == '\r'))
+		n--;
+	start = n > 7000 ? n - 7000 : 0;
+	for (uint32_t i = start; i < n; i++) {
+		uint8_t c = buf[i];
+		if (c >= 32 && c < 127 && ll < sizeof(line) - 1) {
+			line[ll++] = c;
+			continue;
+		}
+		line[ll] = 0;
+		if (ll)
+			printf("%s|%s\n", tag, line);
+		ll = 0;
+	}
+	line[ll] = 0;
+	if (ll)
+		printf("%s|%s\n", tag, line);
+}
+
+static void
+diting_ufslog_hex(const char *tag, const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i += 8) {
+		uint64_t v;
+		memcpy(&v, p + i, 8);
+		if (v)
+			printf("%s+%03x %016llx\n", tag, i, (unsigned long long)v);
+	}
+}
+
+/* Re-read the previous boot's zones from the reserve and print their tails.
+ * Returns 1 once the read succeeded so the caller can stop retrying. */
+static unsigned
+diting_ufslog_dump(void)
+{
+	if (!native_ufs_debug_read)
+		return 0;
+	if (!native_ufs_debug_read(0, DITING_RAMOOPS_ZONE_BLOCKS, diting_ufslog_buf))
+		return 0;
+	printf("=== UFSLOG zone1 tail ===\n");
+	if (native_ufs_debug_read((uint64_t)DITING_RAMOOPS_ZONE_BLOCKS,
+	        DITING_RAMOOPS_ZONE_BLOCKS, diting_ufslog_buf))
+		diting_ufslog_emit("z1", diting_ufslog_buf, DITING_RAMOOPS_ZONE_BYTES);
+	printf("=== UFSLOG exception records ===\n");
+	if (native_ufs_debug_read(DITING_RAMOOPS_RECORD_LBA, 2, diting_ufslog_buf)) {
+		diting_ufslog_hex("rec-sync", diting_ufslog_buf, 0x100);
+		diting_ufslog_hex("rec-serr", diting_ufslog_buf + 0x800, 0x100);
+		diting_ufslog_hex("rec-invs", diting_ufslog_buf + 0x1000, 0x100);
+	}
+	printf("=== UFSLOG zone0 console tail ===\n");
+	if (native_ufs_debug_read(0, DITING_RAMOOPS_ZONE_BLOCKS, diting_ufslog_buf))
+		diting_ufslog_emit("z0", diting_ufslog_buf, DITING_RAMOOPS_ZONE_BYTES);
+	printf("=== UFSLOG done ===\n");
+	return 1;
+}
+
+static void
+ramoops_ufs_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t flushed[2] = { 0, 0 }, want_log = 0;
+	unsigned ticks = 0, logged = 0, log_tries = 0, reprinted = 0;
+	PE_parse_boot_argn("diting_ufslog", &want_log, sizeof(want_log));
+	for (;;) {
+		vm_offset_t base = diting_ramoops_mapped_base();
+		if (want_log && !logged) {
+			if (diting_ufslog_dump()) {
+				logged = 1;
+			} else if (++log_tries > 300) {
+				logged = 1;
+				printf("=== UFSLOG read never ready ===\n");
+			} else {
+				IOSleep(100);
+				continue;
+			}
+		}
+		if (logged && reprinted < 2 && ++reprinted < 3) {
+			/* Let the dump settle on screen, then show the console tail once
+			 * more so a late photo still lands on the important lines. */
+			IOSleep(8000);
+			if (native_ufs_debug_read &&
+			    native_ufs_debug_read(0, DITING_RAMOOPS_ZONE_BLOCKS, diting_ufslog_buf)) {
+				printf("=== UFSLOG zone0 tail (repeat) ===\n");
+				diting_ufslog_emit("z0", diting_ufslog_buf, DITING_RAMOOPS_ZONE_BYTES);
+				printf("=== UFSLOG repeat done ===\n");
+			}
+			continue;
+		}
+		if (native_ufs_debug_write && base) {
+			unsigned periodic = (ticks % 20) == 0, touched = periodic;
+			for (unsigned zone = 0; zone < 2; zone++) {
+				uint32_t size = diting_ramoops_zone_size(zone);
+				uint32_t blocks = (size + 16 + 4095) / 4096;
+				if (blocks > DITING_RAMOOPS_ZONE_BLOCKS)
+					blocks = DITING_RAMOOPS_ZONE_BLOCKS;
+				if ((size != flushed[zone] || periodic) &&
+				    native_ufs_debug_write((uint64_t)zone * DITING_RAMOOPS_ZONE_BLOCKS,
+				        blocks,
+				        (const void *)(uintptr_t)(base + zone * DITING_RAMOOPS_ZONE_BYTES))) {
+					flushed[zone] = size;
+					if (zone == 0)
+						touched = true;
+				}
+			}
+			if (touched)
+				native_ufs_debug_write(DITING_RAMOOPS_RECORD_LBA, 2,
+				    (const void *)(uintptr_t)(base + 0x1f0000));
+		}
+		++ticks;
+		IOSleep(100);
+	}
+}
+
+void
+diting_ramoops_ufs_init(void)
+{
+	uint32_t enabled = 0; thread_t worker;
+	if (!PE_parse_boot_argn("diting_ramoops_ufs", &enabled, sizeof(enabled)) || !enabled) return;
+	if (kernel_thread_start(ramoops_ufs_thread, NULL, &worker) == KERN_SUCCESS)
+		thread_deallocate(worker);
+}
