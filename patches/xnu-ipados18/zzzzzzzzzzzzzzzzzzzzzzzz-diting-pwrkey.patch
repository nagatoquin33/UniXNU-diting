 /* Diting SM8475 PMIC keys. Read-only peripheral access, adapted from the earlier
  * redwood_buttons.c (APSL 2.0) and NothingOSS spmi-pmic-arb.c register layouts.
- * No PMIC configuration/reset/supply writes and no display/GPU dependency. */
+ * No PMIC configuration/reset/supply writes and no display/GPU dependency.
+ * A long power-key press powers the SoC off through PSCI SYSTEM_OFF; the PSCI
+ * call goes through the same SMCCC SMC conduit the firmware serves to the
+ * reference BootReset code. */
 #include <pexpert/arm64/board_config.h>
