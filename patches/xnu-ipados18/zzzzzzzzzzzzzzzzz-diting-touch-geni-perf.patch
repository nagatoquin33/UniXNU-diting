+	}
+	if (rd(smmu + 0x800 + 4 * slot) != (0x80000000u | QUP_WRAPPER_SID) || rd(smmu + 0xc00 + 4 * slot) != bank) {
+		err = "SMMU SMR readback failed";
+		goto out;
+	}
+out:
+	diting_smmu_lease_unlock();
+	return err;
