  * the first SwapBegin. Zero means the queued work, not an invalid frame.
  * High-bit flags are readiness polls (can_update expects Busy); they must
  * never sleep for a future frame and stall the render server. */
+void IOMobileFramebuffer::swapPresentedLocked(uint32_t id)
+{
+    if(id!=0 && (int32_t)(id-fPresentedID)>0) {
+        fRetiredID=id-1;
+        fPresentedID=id;
+        IOLockWakeup(fSwapLock,&fSwapsWaiting,false);
+    }
+}
