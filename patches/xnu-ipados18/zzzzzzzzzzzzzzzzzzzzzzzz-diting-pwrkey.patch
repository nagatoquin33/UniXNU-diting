     {.code=DITING_BUTTON_VOLUME_DOWN}};
+/* Power-key hold handling: diting_pwrkey_long (ms, default 5000) and
+ * diting_pwrkey_log=1 for raw RT_STS transitions. */
+static uint32_t pwrkey_log,pwrkey_long_ms=5000,pwrkey_last_state;
+static uint64_t pwrkey_down_at;
+static bool pwrkey_off_failed;
 static uint32_t rd(vm_offset_t a) {return *(volatile uint32_t *)a;}
 static void wr(vm_offset_t a,uint32_t v) {*(volatile uint32_t *)a=v;__asm__ volatile("dsb sy":::"memory");}
+/* One SMCCC call through SMC: PSCI VERSION 0x84000000, FEATURES 0x8400000a,
+ * SYSTEM_OFF 0x84000008. Returns x0. */
+static uint64_t diting_psci(uint64_t fn,uint64_t arg)
+{
+    register uint64_t x0 __asm__("x0")=fn,x1 __asm__("x1")=arg,x2 __asm__("x2")=0,x3 __asm__("x3")=0;
+    __asm__ volatile("smc #0":"+r"(x0),"+r"(x1),"+r"(x2),"+r"(x3)
+        ::"memory","x4","x5","x6","x7","x8","x9","x10","x11","x12","x13","x14","x15","x16","x17");
+    return x0;
+}
 
