+		wr(smmu + 0x1000 + 4 * bank, 0x10000u);
+	}
+	if (rd(cb) != 0 || rd(smmu + 0x1800 + 4 * bank) != 1 || rd(smmu + 0x1000 + 4 * bank) != 0x10000u) {
